{
  "name": "sigmod-org",
  "private": true,
  "type": "module",
  "description": "Static site for ACM SIGMOD and PODS (migrated from WordPress)",
  "scripts": {
    "hall-of-fame": "node scripts/pods-hall-of-fame.mjs",
    "prebuild": "node scripts/pods-hall-of-fame.mjs",
    "build": "eleventy --quiet",
    "serve": "eleventy --serve --port=8080 --quiet",
    "import": "node scripts/import-wp.mjs",
    "old-links": "eleventy --quiet && node scripts/old-links-report.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.2",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  }
}
