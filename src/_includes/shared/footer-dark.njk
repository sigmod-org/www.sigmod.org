{#- Partner logos and the black footer, shared by all designs. Styles: /assets/footer.css #}
<section class="partners-band" aria-label="Partners">
  <div class="partners-in">
    <p>Partners</p>
    {%- for p in site.partners %}
    <a href="{{ p.url }}" title="{{ p.name }}"><img src="{{ p.logo }}" alt="{{ p.name }}" loading="lazy"></a>
    {%- endfor %}
  </div>
</section>
<footer class="xfoot">
  <div class="xfoot-in">
    <div class="xfoot-about">
      <p>{{ site.longTitle }}, and sponsor of the Symposium on Principles of Database Systems.</p>
      <p class="xfoot-volunteer"><strong>Run by volunteers.</strong> {{ site.volunteerNote }}
        <a href="{{ site.repo }}/issues/new">Report a problem</a> or <a href="{{ site.editBase }}{{ editPath or (page.inputPath | replace('./', '')) }}">suggest an edit</a>.</p>
      <a class="xfoot-acm" href="https://www.acm.org/" title="Association for Computing Machinery"><img src="/assets/logo/acm.png" alt="ACM, Association for Computing Machinery" width="160" height="56"></a>
    </div>
    <nav class="xfoot-col" aria-label="SIGMOD">
      <h2>SIGMOD</h2>
      <ul>{% for m in nav.sigmod.menus %}<li><a href="{{ m.url }}">{{ m.label }}</a></li>{% endfor %}<li><a href="/news/">News</a></li></ul>
    </nav>
    <nav class="xfoot-col" aria-label="PODS">
      <h2>PODS</h2>
      <ul>{% for m in nav.pods.menus %}<li><a href="{{ m.url }}">{{ m.label }}</a></li>{% endfor %}</ul>
    </nav>
    <nav class="xfoot-col" aria-label="Get involved">
      <h2>Get involved</h2>
      <ul>
        <li><a href="{{ nav.join.url }}">{{ nav.join.label }}</a></li>
        <li><a href="/membership/sigmod-chapters/">Chapters</a></li>
        <li><a href="/feed.xml">News feed</a></li>
        <li class="xfoot-social">
          <a href="https://www.linkedin.com/company/acm-sigmod" rel="me" title="SIGMOD on LinkedIn" aria-label="SIGMOD on LinkedIn"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>
          <a href="https://x.com/sigmod" rel="me" title="SIGMOD on X" aria-label="SIGMOD on X"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="currentColor"><path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64z"/></svg></a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="xfoot-bottom">
    <span>© {{ currentYear }} ACM SIGMOD is a Special Interest Group of the <a href="https://www.acm.org/">Association for Computing Machinery</a>.</span>
    <span><a href="{{ site.repo }}">Source on GitHub</a></span>
  </div>
</footer>
