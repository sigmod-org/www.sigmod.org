---
layout: base.njk
---
{%- set menu = nav.main | findMenu(page.url, area) -%}
<div class="page-head">
  <div class="wrap">
    <p class="crumbs"><a href="/">Home</a>{% if menu %}<span>/</span><a href="{{ menu.url }}">{{ menu.label }}</a>{% endif %}{% if wp_type == "post" %}<span>/</span><a href="/news/">News</a>{% endif %}</p>
    <h1>{{ title }}</h1>
    {%- if wp_type == "post" %}<p class="page-date">{{ date | date }}</p>{% endif %}
  </div>
</div>
<div class="wrap page-grid{% if not menu %} no-side{% endif %}{% if wide %} wide{% endif %}">
  <article class="prose">
    {#- Wide pages (full-width tables): the menu sits beside the introduction, the tables start below it -#}
    {%- if menu and wide %}<aside class="side side-intro">{% include "shared/side-menu.njk" %}</aside>{% endif %}
    {{ content | safe }}
    {% include "shared/meta.njk" %}
  </article>
  {%- if menu and not wide %}<aside class="side">{% include "shared/side-menu.njk" %}</aside>{% endif %}
  {%- if menu and wide %}<aside class="side side-end">{% include "shared/side-menu.njk" %}</aside>{% endif %}
</div>
